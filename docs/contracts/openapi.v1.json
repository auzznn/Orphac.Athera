{
  "openapi": "3.1.1",
  "info": {
    "title": "Orphac.Athera.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "GetCsrfToken",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "Logout",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces": {
      "get": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "ListWorkspaces",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspacesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{tenantId}/entities": {
      "get": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "ListTenantEntities",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantEntitiesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{tenantId}/entities/{entityId}": {
      "get": {
        "tags": [
          "Orphac.Athera.Api"
        ],
        "operationId": "GetEntityWorkspaceDetail",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "requirePermission",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityWorkspaceDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizedTenantDto": {
        "required": [
          "tenantId",
          "code",
          "name",
          "status",
          "entities"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntityDto"
            }
          }
        }
      },
      "AuthSessionResponse": {
        "required": [
          "user",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/CurrentUserResponse"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "CsrfTokenResponse": {
        "required": [
          "headerName",
          "requestToken"
        ],
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "requestToken": {
            "type": "string"
          }
        }
      },
      "CurrentUserResponse": {
        "required": [
          "userId",
          "email",
          "displayName",
          "preferredLocale",
          "lastSignedInAtUtc",
          "workspaceAccessStatus",
          "authorizedWorkspaceCount"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "preferredLocale": {
            "type": "string"
          },
          "lastSignedInAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "workspaceAccessStatus": {
            "type": "string"
          },
          "authorizedWorkspaceCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EntityWorkspaceDetailResponse": {
        "required": [
          "tenant",
          "entity",
          "effectivePermissions",
          "navigationCapabilities",
          "serverTimestampUtc"
        ],
        "type": "object",
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/TenantSummaryDto"
          },
          "entity": {
            "$ref": "#/components/schemas/LegalEntityDto"
          },
          "effectivePermissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "navigationCapabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleNavigationItemDto"
            }
          },
          "serverTimestampUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "service",
          "timestampUtc"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LegalEntityDto": {
        "required": [
          "legalEntityId",
          "tenantId",
          "code",
          "name",
          "functionalCurrencyCode",
          "countryCode",
          "timeZoneId",
          "taxRegistrationNpwp",
          "status",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "legalEntityId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "functionalCurrencyCode": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "timeZoneId": {
            "type": "string"
          },
          "taxRegistrationNpwp": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password",
          "rememberMe"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean"
          }
        }
      },
      "LogoutResponse": {
        "required": [
          "signedOut",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "signedOut": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "ModuleNavigationItemDto": {
        "required": [
          "key",
          "status",
          "permitted",
          "requiredPermission"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "permitted": {
            "type": "boolean"
          },
          "requiredPermission": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TenantEntitiesResponse": {
        "required": [
          "tenant",
          "entities",
          "evaluatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/TenantSummaryDto"
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntityDto"
            }
          },
          "evaluatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TenantSummaryDto": {
        "required": [
          "tenantId",
          "code",
          "name",
          "status"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "WorkspacesResponse": {
        "required": [
          "tenants",
          "totalAuthorizedEntities",
          "evaluatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizedTenantDto"
            }
          },
          "totalAuthorizedEntities": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "evaluatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Orphac.Athera.Api"
    }
  ]
}
