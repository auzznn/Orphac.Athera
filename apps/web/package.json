{
  "name": "@orphac-athera/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 3200 --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ../../docs/contracts/openapi.v1.json -o src/lib/api/schema.d.ts",
    "api:check": "openapi-typescript ../../docs/contracts/openapi.v1.json -o .openapi.check.d.ts && diff -u src/lib/api/schema.d.ts .openapi.check.d.ts && rm -f .openapi.check.d.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.0.1",
    "next": "^16.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
