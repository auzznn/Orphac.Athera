# Local-only disposable development configuration template.
# Copy to .env (gitignored) or export in your shell. Never commit real credentials or production secrets.

ATHERA_PG_PORT=55433
ATHERA_PG_ADMIN_USER=athera_dev_admin
ATHERA_PG_ADMIN_PASSWORD=replace-with-local-admin-password
ATHERA_PG_MIGRATOR_PASSWORD=replace-with-local-migrator-password
ATHERA_PG_APP_PASSWORD=replace-with-local-app-password
ATHERA_PG_DB=athera_dev

ATHERA_API_UPSTREAM=http://127.0.0.1:5200
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3200

# ASP.NET Core connection strings (do not store real passwords in tracked files)
ConnectionStrings__Migrator=Host=127.0.0.1;Port=55433;Database=athera_dev;Username=athera_migrator;Password=replace-with-local-migrator-password
ConnectionStrings__Runtime=Host=127.0.0.1;Port=55433;Database=athera_dev;Username=athera_app;Password=replace-with-local-app-password
ConnectionStrings__Control=Host=127.0.0.1;Port=55433;Database=athera_dev;Username=athera_app;Password=replace-with-local-app-password
